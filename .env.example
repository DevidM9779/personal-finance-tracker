# Copy this file to `.env.local` and fill in real Firebase credentials when
# deploying to production. Leave these unset (or set VITE_USE_FIREBASE_EMULATORS
# to true) to use the local Firebase emulators in development.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force-disable the emulator wiring in production by setting this to "false".
# In development (`vite dev`) it defaults to "true".
VITE_USE_FIREBASE_EMULATORS=
