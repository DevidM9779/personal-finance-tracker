rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // A user can only read/write their own profile document and all nested
    // financial data underneath their user document. This is a single-user
    // application: each authenticated user only ever sees their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subPath=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
